TRANSLATOR_LAB_VERSION=1.0.0-rc.2
WEB_BIND_HOST=127.0.0.1
TRANSLATION_PROVIDER=local
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite

# ارائه‌دهندهٔ جایگزین اختیاری
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.4-nano

# مدل محلی سازگار با رابط OpenAI؛ برای LM Studio معمولاً درگاه 1234 و برای Ollama درگاه 11434 است
LOCAL_TRANSLATION_BASE_URL=http://127.0.0.1:1234/api/v1
LOCAL_TRANSLATION_MODEL=qwen/qwen3.5-9b
LOCAL_TRANSLATION_API_KEY=lm-studio
LOCAL_TRANSLATION_BATCH_SIZE=1
LOCAL_TRANSLATION_BASE_URL_DOCKER=http://host.docker.internal:1234/api/v1
APPROVED_TRANSLATION_MEMORY_PATH=work/approved-translations/translation-memory.json
OSM_IDENTITY_SNAPSHOT_PATH=work/identity/osm-identity-snapshot.json

# مدل تخصصی آزمایشی؛ در نسخهٔ نامزد تحویل، ارائه‌دهندهٔ فعال مدل محلی Qwen است
MADLAD_TRANSLATION_BASE_URL=http://127.0.0.1:3007
MADLAD_TRANSLATION_BASE_URL_DOCKER=http://host.docker.internal:3007
MADLAD_TRANSLATION_MODEL=google/madlad400-3b-mt
MADLAD_TRANSLATION_BATCH_SIZE=20
MADLAD_TRANSLATION_TIMEOUT_MS=180000

# داوری دومرحله‌ای نام‌های خاص؛ تنها توافق هر دو مدل پذیرفته می‌شود.
PROPER_NAME_JUDGE_ENABLED=true
PROPER_NAME_JUDGE_BASE_URL=http://127.0.0.1:1234/api/v1
PROPER_NAME_JUDGE_BASE_URL_DOCKER=http://host.docker.internal:1234/api/v1
PROPER_NAME_JUDGE_MODEL=qwen3.5-4b
PROPER_NAME_JUDGE_SECONDARY_MODEL=qwen/qwen3.5-9b
PROPER_NAME_JUDGE_TIMEOUT_MS=120000
PROPER_NAME_JUDGE_BATCH_SIZE=1

# اگر مدل محلی روی ویندوز اجرا می‌شود و سرویس پشتیبان در داکر است، از این نشانی استفاده شود:
# برای اولاما در داکر: LOCAL_TRANSLATION_BASE_URL_DOCKER=http://host.docker.internal:11434/v1

# پایگاه داده آزمایشی محلی
POSTGRES_DB=translator_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5434
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5434/translator_lab
DATABASE_SCHEMA=public
DATABASE_TABLE=geoms
DATABASE_SSL_MODE=disable
FEATURE_API_HOST=127.0.0.1
FEATURE_API_PORT=3006
FEATURE_API_ALLOWED_ORIGINS=http://127.0.0.1:3005,http://localhost:3005
VITE_FEATURES_API_URL=http://127.0.0.1:3006/api/v1/features

# پویشگر مداوم؛ در نصب اولیه ثبت خاموش است و فقط پس از آزمون پذیرش فعال می‌شود
TRANSLATION_WORKER_ENABLED=true
TRANSLATION_AUTO_APPLY=false
TRANSLATION_ALLOW_API_APPLY=false
ONLINE_PROVIDER_COMPARISON_ENABLED=false
TRANSLATION_WORKER_BATCH_SIZE=20
TRANSLATION_WORKER_INTERVAL_MS=300000
