{
  "name": "map-translation-lab",
  "version": "1.0.0-rc.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "backend:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch server/index.mjs",
    "backend:start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/translation-policy.test.mjs tests/sql-workflow.test.mjs tests/feature-api.test.mjs tests/database-connection.test.mjs tests/translation-provider.test.mjs tests/translation-memory.test.mjs tests/canonical-place-names.test.mjs tests/canonical-language-audit.test.mjs tests/language-readiness.test.mjs tests/source-script.test.mjs tests/proper-name-router.test.mjs tests/proper-name-judge.test.mjs tests/semantic-equivalence.test.mjs tests/translation-worker.test.mjs && python -m unittest discover -s tests -p \"test_*.py\"",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "release:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_release.ps1",
    "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_release.ps1"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
